<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ─── Tracking ──────────────────────────────────────────────────────── -->
  <!--
    The app uses AdMob personalized advertising and Firebase Analytics,
    both of which require the App Tracking Transparency (ATT) prompt.
    Set to true so the system enforces the ATT gate before ad delivery.
  -->
  <key>NSPrivacyTracking</key>
  <true/>

  <!-- ─── Tracking Domains ──────────────────────────────────────────────── -->
  <!--
    Domains contacted for tracking/advertising purposes.
    Required for any domain used to track users across apps / websites.
  -->
  <key>NSPrivacyTrackingDomains</key>
  <array>
    <string>googleadservices.com</string>
    <string>googlesyndication.com</string>
    <string>google-analytics.com</string>
    <string>googletagmanager.com</string>
    <string>doubleclick.net</string>
    <string>firebase.google.com</string>
    <string>firebaselogging.googleapis.com</string>
    <string>app-measurement.com</string>
  </array>

  <!-- ─── Collected Data Types ─────────────────────────────────────────── -->
  <!--
    Categories of data collected by the app, Firebase Analytics,
    and AdMob – as required by App Store Connect Privacy Nutrition Label.
  -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array>

    <!-- Device ID (IDFA / IDFV) used for ad targeting -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <true/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Coarse location for geo-targeted ads (not precise) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
      </array>
    </dict>

    <!-- Product interaction (in-app events) sent to Firebase Analytics -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Crash / diagnostic data (Firebase Crashlytics) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Performance metrics (Firebase Performance) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePerformanceData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

  </array>

  <!-- ─── Accessed API Types ────────────────────────────────────────────── -->
  <!--
    APIs whose usage must be declared since iOS 17 / Xcode 15.
    flutter_secure_storage and shared_preferences both access NSUserDefaults.
  -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>

    <!-- NSUserDefaults - used by shared_preferences and Flutter internals -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- CA92.1: Read/write data from the same app that wrote it -->
        <string>CA92.1</string>
      </array>
    </dict>

    <!-- File timestamp APIs - accessed by Firebase/GDT internal SDK -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- C617.1: Inside app container, no transmission to third parties -->
        <string>C617.1</string>
      </array>
    </dict>

    <!-- System boot time - accessed by Firebase Performance Monitoring -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <!-- 35F9.1: Calculate time elapsed since a system event -->
        <string>35F9.1</string>
      </array>
    </dict>

  </array>

</dict>
</plist>
